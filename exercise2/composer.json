{
    "name": "exercise2/api",
    "type": "project",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Api\\": "src/api/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Api\\Tests\\": "src/api/Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
